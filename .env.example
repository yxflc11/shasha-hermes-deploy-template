# Public placeholders only. Copy to .env locally and never commit the result.
HERMES_IMAGE=your-registry.example/shasha-hermes:verified
HERMES_DATA_DIR=/var/lib/shasha-hermes
ACT_VAULT_DIR=/srv/act-vault
HERMES_DASHBOARD_ENV_FILE=./dashboard.env.example
HERMES_DASHBOARD_BIND=127.0.0.1
HERMES_DASHBOARD_PORT=9119

# Used by local import scripts. Keep the real values in the local environment.
ACT_CAPTURE_SSH_TARGET=deploy@example-host
ACT_CAPTURE_REMOTE_JOURNAL=/var/lib/shasha-hermes/act-capture/journal.jsonl
ACT_COMPANION_REMOTE_JOURNAL=/var/lib/shasha-hermes/act-companion/journal.jsonl

# Used only with deploy/compose.private-overlay.example.yaml.
SHASHA_PRIVATE_OVERLAY_DIR=/private/path/shasha-persona

# Channel/model secrets intentionally have no example values.
TELEGRAM_BOT_TOKEN=
MODEL_API_KEY=
